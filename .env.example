# Copia este archivo como ".env" y rellena tus claves. NUNCA subas el ".env" a GitHub.

# --- Claves obligatorias ---
OPENAI_API_KEY=tu_clave_de_openai
COHERE_API_KEY=tu_clave_de_cohere
NEWS_API_KEY=tu_clave_de_newsapi

# --- Ajustes opcionales (valores por defecto) ---
ENVIRONMENT=development
MAX_RETRIES=3
REQUEST_TIMEOUT=30
DAILY_BUDGET=5.00
